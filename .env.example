# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/libraryms

# Server and authentication
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
LIBRARIAN_SIGNUP_CODE=

# Public URLs
APP_URL=http://localhost:3000   # on Netlify: your site URL, e.g. https://your-site.netlify.app
FRONTEND_URL=http://localhost:3000

# Optional Gmail SMTP
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_VERIFICATION_ENABLED=false

# Optional bKash payment integration
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
